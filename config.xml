<?xml version='1.0' encoding='utf-8'?>
<widget id="com.barry.psrengine" version="1.0.0" xmlns="http://w3.org" xmlns:cdv="http://apache.org">
    <name>Nigeria PSR Engine</name>
    <description>Offline Search Engine for the Federal Public Service Rules.</description>
    <author email="barry@example.com" href="https://github.com">Barry Dev</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="portrait" />
        <!-- System boot layout adjustments to eliminate initial blank flashes -->
    <preference name="BackgroundColor" value="0xffffffff" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="AutoHideSplashScreen" value="true" />

    <!-- Fallback default app icon linked directly from your root folder -->
    <icon src="icon-512.png" />

    <!-- Link your available icon sizes for Android density scaling -->
    <platform name="android">
        <icon src="icon-192.png" density="xhdpi" />
        <icon src="icon-512.png" density="xxxhdpi" />
    </platform>
</widget>
